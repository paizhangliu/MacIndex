<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 5.0 deletes these obsolete 4.9.1 runtime files during startup. -->
        <exclude domain="database" path="specs.db" />
        <exclude domain="database" path="specs.db-journal" />
        <exclude domain="database" path="specs.db-shm" />
        <exclude domain="database" path="specs.db-wal" />
        <exclude domain="database" path="specs.db.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="specs.db" />
        <exclude domain="database" path="specs.db-journal" />
        <exclude domain="database" path="specs.db-shm" />
        <exclude domain="database" path="specs.db-wal" />
        <exclude domain="database" path="specs.db.tmp" />
    </device-transfer>
</data-extraction-rules>
