<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SearchActivity">

    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:imeOptions="actionSearch"
        app:iconifiedByDefault="false"
        app:queryHint="@string/search_hint" />

    <TextView
        android:id="@+id/textResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:minHeight="32dp"
        android:textColor="@color/colorDefaultText"
        android:textSize="14sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:id="@+id/searchFacetContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:scrollbars="none"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/searchFacetGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/searchFacetAll"
                style="@style/SearchFacetChip" />

            <RadioButton
                android:id="@+id/searchFacetName"
                style="@style/SearchFacetChip" />

            <RadioButton
                android:id="@+id/searchFacetCodename"
                style="@style/SearchFacetChip" />

            <RadioButton
                android:id="@+id/searchFacetModelNumber"
                style="@style/SearchFacetChip" />

            <RadioButton
                android:id="@+id/searchFacetModelIdentifier"
                style="@style/SearchFacetChip" />

            <RadioButton
                android:id="@+id/searchFacetGestaltId"
                style="@style/SearchFacetChip" />

            <RadioButton
                android:id="@+id/searchFacetPartNumber"
                style="@style/SearchFacetChip" />

            <RadioButton
                android:id="@+id/searchFacetEmcNumber"
                style="@style/SearchFacetChip" />

            <RadioButton
                android:id="@+id/searchFacetProcessor"
                style="@style/SearchFacetChip" />

            <RadioButton
                android:id="@+id/searchFacetIntroduction"
                style="@style/SearchFacetChip" />

        </RadioGroup>

    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/listDivider" />

    <ListView
        android:id="@+id/resultList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />

</LinearLayout>
